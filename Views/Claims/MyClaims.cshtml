@model IEnumerable<Part2_CMCS.Models.Claim>

@{
    ViewData["Title"] = "My Claims";
}

<h2>My Submitted Claims</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Total</th>
            <th>Status</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.DateSubmitted.ToString("yyyy-MM-dd")</td>
                <td>@(c.HoursWorked* c.HourlyRate)</td>
                <td>@c.Status</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="ClaimDetails" asp-route-id="@c.Id">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
